# Canonical origin for the whole site: canonical tags, sitemap.xml, robots.txt,
# llms.txt, Open Graph tags, and JSON-LD are all built from it.
#
# Set this in Vercel (Settings > Environment Variables) to the exact host the
# pages are served from, including "www." when the primary domain uses it, and
# without a trailing slash. Changing the domain then means changing this value
# only, never the code.
#
# If it is left unset, the site falls back to Vercel's own
# VERCEL_PROJECT_PRODUCTION_URL, then to the default in app/data/site.js.
NEXT_PUBLIC_SITE_URL=https://www.mdshakilhossen.info
